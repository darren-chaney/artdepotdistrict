rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read collections
    match /businesses/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /site_config/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /faqs/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /depot_days/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public create (form submissions), auth read
    match /car_show_registrations/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Auth only — chat logs and admin data
    match /chat_logs/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /users/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
