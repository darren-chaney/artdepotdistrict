rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read collections
    match /businesses/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /site_config/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /faqs/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /depot_days/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public create (form submissions), auth read/write
    match /car_show_registrations/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Vendor registrations — public create, auth read/write
    // checkedIn field can be updated via the checkin page (no auth needed for that one field)
    match /vendor_registrations/{id} {
      allow create: if true;
      allow read:   if true;
      allow update: if request.auth != null
                    || (request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['checkedIn','checkedInAt']));
      allow delete: if request.auth != null;
    }

    // Report config — admin only (email addresses must stay private)
    match /report_config/{id} {
      allow read, write: if request.auth != null;
    }

    // Analytics config and reports — admin only
    match /analytics_config/{id} {
      allow read, write: if request.auth != null;
    }
    match /analytics_reports/{id} {
      allow read, write: if request.auth != null;
    }

    // Auth only — chat logs
    match /chat_logs/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /users/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
